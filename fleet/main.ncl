# Entry point. `nickel export fleet/main.ncl` gives:
#   fleet  - the checked data (roles, environments) that Nix and Yen read
#   files  - every generated file, path => content (written by ./generate)
let S = import "schema.ncl" in
let all_roles = import "roles.ncl" in
let environments = import "environments.ncl" in

let repo_name = "indeterminate-systems/000.02-fleetrc" in
let checkout = "000.02-fleetrc" in

let slug = fun name =>
  name |> std.string.lowercase |> std.string.replace_regex "[^a-z0-9]+" "-" in

# a managed environment must name a role that exists
let checked_envs = environments |> std.record.map (fun name env =>
  if env.managed then
    if !(std.record.has_field "role" env) then
      std.fail_with "environment %{name} is managed but has no role"
    else if !(std.record.has_field env.role all_roles) then
      std.fail_with "environment %{name}: unknown role '%{env.role}' (roles: %{std.string.join ", " (std.record.fields all_roles)})"
    else env
  else env) in

let setup_script = fun name env =>
m%"
#!/usr/bin/env bash
# GENERATED by fleetrc (fleet/main.ncl) - edit the repo, not this box.
# environment: %{name} (%{env.id})
# role:        %{env.role}
%{if env.notes == "" then "#" else "# notes: " ++ env.notes}
# The bootstrap never fails the session: on any problem it warns and exits 0.
set -uo pipefail
warn() { echo "fleetrc: $*" >&2; exit 0; }
# shellcheck source=/dev/null
[ -e /nix/var/nix/profiles/default/etc/profile.d/nix.sh ] && . /nix/var/nix/profiles/default/etc/profile.d/nix.sh
export PATH=/nix/var/nix/profiles/default/bin:$PATH
command -v nix-build >/dev/null || warn "nix is not installed on this box"
# The session's repositories are cloned before this script runs, into the current directory.
# The repo is private, so a fresh clone only works if it is made public.
if [ -d %{checkout}/.git ]; then src=$PWD/%{checkout}
elif [ -d /opt/fleetrc/.git ] || git clone -q --depth 1 https://github.com/%{repo_name}.git /opt/fleetrc; then src=/opt/fleetrc
else warn "no fleetrc checkout: attach %{repo_name} to the session"; fi
export FLEETRC_SRC=$src
rc=$(nix-build --no-out-link "$src" -A rc) || warn "building rc failed"
"$rc/bin/fleetrc" apply %{env.role} || warn "fleetrc apply %{env.role} failed"
"%
in

let fleet_data = { roles = all_roles, environments = checked_envs, repo = repo_name } in

let managed = checked_envs |> std.record.filter (fun _n e => e.managed) in

let ci = {
  name = "fleetrc",
  on = { push = {}, pull_request = {} },
  jobs.check = {
    runs-on = "ubuntu-latest",
    steps = [
      { uses = "actions/checkout@v4" },
      { uses = "cachix/install-nix-action@v31",
        with.extra_nix_config = "experimental-features = nix-command" },
      { name = "Generated files match fleet/*.ncl", run = "nix-shell -A shell --run './generate --check'" },
      { name = "Lint", run = "nix-shell -A shell --run 'shellcheck generate nix/fleetrc.sh generated/setup/*.sh'" },
      { name = "Yen fleet rules", run = "nix-build -A check" },
      { name = "Yen rule tests", run = "nix-build -A tests" },
    ] @ (std.record.values all_roles |> std.array.length |> std.array.generate (fun i =>
      let r = std.array.at i (std.record.fields all_roles) in
      { name = "Build role %{r}", run = "nix-build -A role.%{r}" })),
  },
} in

{
  fleet = fleet_data,
  files =
    (managed |> std.record.to_array |> std.array.map (fun e =>
      let path = "generated/setup/%{slug e.field}.sh" in
      let body = setup_script e.field e.value ++ "\n" in
      { field = path, value = body })
     |> std.record.from_array)
    & {
      "generated/fleet.json" = std.serialize 'Json fleet_data ++ "\n",
      ".github/workflows/fleetrc.yml" = "# GENERATED by fleetrc (fleet/main.ncl)\n" ++ std.serialize 'Yaml ci,
    },
}
